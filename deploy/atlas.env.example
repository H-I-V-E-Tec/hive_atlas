# /srv/hive-private/atlas.env — root:root 0600 (opcional)
# Overrides do deploy da biblioteca Atlas. Sem este arquivo, o deploy_server.sh
# usa os padrões abaixo, que reusam o Qdrant/Ollama do hive_mind no mesmo host.

# REST do Qdrant (loopback TLS do hive_mind). Atenção: a porta REST é 6333.
ATLAS_QDRANT_REST=https://127.0.0.1:6333

# CA privada que assina o certificado do Qdrant (lida como root no deploy).
QDRANT_TLS_CA_FILE=/srv/hive-private/ca.crt

# Collection transversal do Atlas (sem program_id).
ATLAS_COLLECTION=atlas_signals_v01

# Ollama local e modelo de embeddings (o mesmo do hive_mind).
ATLAS_OLLAMA_URL=http://127.0.0.1:11434
ATLAS_EMBEDDING_MODEL=nomic-embed-text

# API Atlas: use a porta seguinte à do Mind. Em produção, o Caddy alcança a
# interface gateway da rede privada do Center (não exponha essa porta na internet).
HIVE_CENTER_URL=https://hive-center.duckdns.org
ATLAS_HTTP_ADDR=172.28.0.1:8444
ATLAS_HEALTH_URL=http://172.28.0.1:8444/healthz
